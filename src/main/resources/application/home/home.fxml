<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.home.HomeController">
   <top>
      <AnchorPane prefHeight="600.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <HBox layoutX="50.0" layoutY="170.0" prefHeight="380.0" prefWidth="500.0" spacing="10.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="363.0" prefWidth="160.0" style="-fx-border-color: red;">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="テスト">
                           <font>
                              <Font size="24.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="30.0" />
                           </VBox.margin>
                        </Text>
                        <Button fx:id="toTestButton" mnemonicParsing="false" onAction="#switchHomeToTest" text="Go" />
                     </children></VBox>
                  <VBox alignment="CENTER" prefHeight="363.0" prefWidth="160.0" style="-fx-border-color: blue;">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="結果">
                           <font>
                              <Font size="24.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="30.0" />
                           </VBox.margin>
                        </Text>
                        <Button fx:id="toResultButton" mnemonicParsing="false" onAction="#switchHomeToResult" text="Go" />
                     </children></VBox>
                  <VBox alignment="CENTER" prefHeight="363.0" prefWidth="160.0" style="-fx-border-color: green;">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="練習">
                           <font>
                              <Font size="24.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="30.0" />
                           </VBox.margin>
                        </Text>
                        <Button fx:id="toPracticeSelectionButton" mnemonicParsing="false" onAction="#switchHomeToPracticeSelection" text="Go" />
                     </children></VBox>
               </children>
            </HBox>
            <Text layoutX="181.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="タイピング練習アプリ">
               <font>
                  <Font size="30.0" />
               </font>
            </Text>
         </children>
      </AnchorPane>
   </top>
</BorderPane>
